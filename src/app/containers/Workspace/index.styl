@import "../variables";

.workspace {
    .dropzone-overlay {
        position: fixed;
        top: $navbar-height;
        bottom: 0;
        left: $sidebar-width;
        right: 0;
        z-index: 100;
        background-color: rgba(255, 255, 255, .5);
        border: 4px dashed #286090;
        text-align: center;
        pointer-events: none;

        &.hidden {
            display: none;
        }

        .text-block {
            position: absolute;
            top: 25%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #666;
            font-size: 32px;
        }
    }
    .dropzone {
        height: 100%;
    }

    .workspace-table {
        display: table;
        width: 100%;
        height: 'calc(100vh - %s)' % ($navbar-height);
    }
    .workspace-table-row {
        display: table-row;
    }

    .primary-container,
    .secondary-container,
    .primary-toggler,
    .secondary-toggler,
    .default-container {
        display: table-cell;
        position: relative;
    }
    .primary-container {
        border-right: 1px solid #ccc;
    }
    .secondary-container {
        border-left: 1px solid #ccc;
    }
    .primary-container,
    .secondary-container {
        vertical-align: top;
        background-color: #f6f7f8;
        width: 360px;
        max-width: 360px;
        min-width: 360px;
        padding: 0 10px;

        &.hidden {
            display: none;
        }
    }
    .primary-toggler,
    .secondary-toggler {
        background-color: #f6f7f8;
        padding-top: 5px;
        text-align: center;
        width: $toggler-width;

        // http://stackoverflow.com/questions/32272158/how-to-use-a-stylus-variable-in-calc
        height: 'calc(100vh - %s)' % ($navbar-height);
    }
    .primary-toggler {
        border-right: 1px solid #ccc;
    }
    .secondary-toggler {
        border-left: 1px solid #ccc;
    }
    .default-container {
        min-width: 360px;

        &.fixed {
            position: fixed;
            left: 360px;
            right: 360px;
            top: ($navbar-height + 1);
            bottom: 0;
        }

        &.hidden {
            display: none;
        }
    }

    .mobile-pane-switch {
        display: none;
    }
}

@media (max-width: 1100px) {
    .workspace {
        min-height: 100%;

        .dropzone-overlay {
            top: var(--cnc-header-h, 52px);
            left: 0;
            right: 0;
            bottom: calc(var(--cnc-bottom-nav-h, 64px) + env(safe-area-inset-bottom, 0px));
            border-width: 3px;
            border-radius: var(--cnc-radius, 14px);
            margin: 8px;
            background: rgba(238, 243, 247, 0.72);
        }

        .dropzone {
            height: auto;
            min-height: 100%;
        }

        .mobile-top-chrome {
            position: sticky;
            top: 0;
            z-index: 30;
        }

        .mobile-pane-switch {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 6px;
            margin: 0;
            padding: 10px 12px 8px;
            background: linear-gradient(180deg, rgba(238, 243, 247, 0.96), rgba(238, 243, 247, 0.88));
            backdrop-filter: blur(10px);
        }

        .mobile-pane-btn {
            appearance: none;
            border: 1px solid var(--cnc-border, rgba(20, 32, 51, 0.12));
            background: var(--cnc-surface, #fff);
            color: var(--cnc-muted, #5b6b7c);
            border-radius: 999px;
            min-height: 40px;
            padding: 8px 10px;
            font-family: var(--cnc-display, inherit);
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.02em;
            transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease, transform 160ms ease;
        }

        .mobile-pane-btn:active {
            transform: scale(0.98);
        }

        .mobile-pane-btn-active {
            background: var(--cnc-ink, #142033);
            border-color: var(--cnc-ink, #142033);
            color: #fff;
            box-shadow: 0 8px 18px rgba(20, 32, 51, 0.18);
        }

        .workspace-table,
        .workspace-table-row {
            display: block;
            height: auto;
            min-height: calc(100vh - var(--cnc-header-h, 52px) - var(--cnc-machine-bar-h, 76px) - var(--cnc-bottom-nav-h, 64px) - var(--cnc-pane-switch-h, 52px));
        }

        .primary-container,
        .secondary-container,
        .default-container,
        .default-container.fixed,
        .primary-toggler,
        .secondary-toggler {
            display: block;
            position: relative;
            width: 100%;
            min-width: 0;
            max-width: none;
            height: auto;
            top: auto;
            bottom: auto;
            // Desktop resize handlers set these offsets inline.
            left: auto !important;
            right: auto !important;
            border: 0;
            background: transparent;
        }

        .primary-container.hidden,
        .secondary-container.hidden,
        .default-container.hidden {
            display: none;
        }

        .mobile-pane {
            animation: cncMobilePaneIn 220ms ease;
            padding: 4px 12px 20px;
        }

        .primary-container.mobile-pane,
        .secondary-container.mobile-pane {
            :global {
                .btn-toolbar {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 8px;
                    margin: 4px 0 12px !important;
                    align-items: center;
                }

                .btn-group {
                    margin: 0 !important;
                }
            }
        }

        .default-container.mobile-pane {
            padding: 0 12px 16px;
        }

        // Touch-friendly controls, but don't force icon chips to grow awkwardly.
        :global {
            button.btn {
                min-height: 44px;
                border-radius: 12px;
                font-family: var(--cnc-font, inherit);
                font-weight: 600;
            }

            button.btn-xs,
            button.btn[style*="min-width: 30"] {
                min-width: 44px;
            }

            .form-control {
                min-height: 44px;
                font-size: 16px;
                border-radius: 12px;
                border-color: var(--cnc-border, #d0d7de);
                box-shadow: none;
            }
        }
    }
}

@keyframes cncMobilePaneIn {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
