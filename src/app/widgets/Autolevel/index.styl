// Widget Content
.widget-content {
  position: relative;
  padding: 10px;

  &.hidden {
    display: none;
  }
}

@media (max-width: 1100px) {
  .widget-content {
    overflow-wrap: anywhere;

    svg {
      max-width: 100%;
      height: auto;
    }

    button {
      white-space: normal;
    }
  }
}
