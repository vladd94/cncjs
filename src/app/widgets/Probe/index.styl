.widget-content {
    position: relative;
    padding: 10px;

    &.hidden {
        display: none;
    }
}

.probe-command-description {
    height: 30px;
}

.probe-axis-description {
    height: 15px;
}

@media (max-width: 1100px) and (orientation: landscape) and (max-height: 600px) {
    .probe-command-description,
    .probe-axis-description {
        height: auto;
        margin-top: 2px;
        margin-bottom: 4px;
        font-size: 12px;
        line-height: 1.25;
    }
}
