// Widget Content
.widget-content {
  position: relative;
  padding: 10px;

  &.hidden {
    display: none;
  }
}

@media (max-width: 1100px) {
  .widget-content {
    overflow-wrap: anywhere;

    svg {
      max-width: 100%;
      height: auto;
    }

    button {
      white-space: normal;
    }

    :global {
      .alert {
        border-radius: 12px;
        border: 0;
        font-family: var(--cnc-font, inherit);
      }

      .alert-success {
        background: var(--cnc-accent-soft, #ccfbf1);
        color: var(--cnc-accent, #0f766e);
      }

      .btn {
        width: 100%;
        justify-content: center;
      }
    }
  }
}
