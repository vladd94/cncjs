.navbar {
    position: relative;
    height: 100%;
}

.icon {
    display: inline-block;
    vertical-align: middle;
    width: 32px;
    height: 32px;

    &.icon-xyz {
        background: url("./images/xyz.svg") no-repeat 0 0;
    }
    &.icon-gear {
        background: url("./images/gear.svg") no-repeat 0 0;
    }
}

.label {
    display: none;
}

.nav-link {
    // styled via .nav > li > a for desktop parity
}

.nav {
    padding-left: 0;
    margin-bottom: 0;
    list-style: none;

    > li {
        position: relative;
        display: block;

        > a {
            position: relative;
            display: block;
            background-color: #222;
            border-bottom: 1px solid #333;
            color: #9d9d9d;
            text-decoration: none;
            white-space: nowrap;
            padding: 10px 0;

            > .icon.icon-invert {
                filter: invert(60%);
            }
        }
        > a:focus,
        > a:hover {
            color: #fff;
            background-color: #222;

            > .icon.icon-invert {
                filter: invert(100%);
            }
        }
    }
    > li.active {
        > a,
        > a:focus,
        > a:hover {
            color: #fff;
            background-color: #080808;

            > .icon.icon-invert {
                filter: invert(100%);
            }
        }
    }
}

@media (max-width: 1100px) {
    .navbar {
        display: flex;
        align-items: stretch;
        justify-content: center;
        height: 100%;
    }

    .nav {
        display: flex;
        width: 100%;
        height: 100%;
        margin: 0;

        > li {
            flex: 1;
            display: flex;

            > a {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 2px;
                width: 100%;
                height: 100%;
                padding: 8px 4px 10px;
                background: transparent;
                border: 0;
                color: rgba(232, 238, 245, 0.62);
                font-family: var(--cnc-display, inherit);
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.04em;
                text-transform: uppercase;

                > .icon {
                    width: 26px;
                    height: 26px;
                    background-size: contain;
                }

                > .icon.icon-invert {
                    filter: invert(75%);
                }
            }

            > a:focus,
            > a:hover {
                color: #fff;
                background: #162033;

                > .icon.icon-invert {
                    filter: invert(100%);
                }
            }
        }

        > li.active {
            > a,
            > a:focus,
            > a:hover {
                color: #fff;
                background: #134e4a;
                border-top: 3px solid #2dd4bf;

                > .icon.icon-invert {
                    filter: invert(100%);
                }
            }
        }
    }

    .label {
        display: block;
        line-height: 1.1;
    }
}

@media (max-width: 1100px) and (orientation: landscape) and (max-height: 600px) {
    .navbar {
        width: auto;
        height: auto;
    }

    .nav {
        width: auto;
        height: auto;
        gap: 4px;

        > li {
            flex: 0 0 auto;

            > a {
                flex-direction: row;
                gap: 4px;
                width: auto;
                height: 40px;
                min-height: 40px;
                box-sizing: border-box;
                padding: 0 10px;
                border-radius: 8px;
                font-size: 11px;
                letter-spacing: .02em;
                white-space: nowrap;

                > .icon {
                    width: 16px;
                    height: 16px;
                }
            }
        }

        > li.active {
            > a,
            > a:focus,
            > a:hover {
                border-top: 0;
                border-radius: 8px;
                background: #134e4a;
                box-shadow: inset 0 0 0 1px #2dd4bf;
            }
        }
    }
}
